PORT=5001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=furnisense_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# Schema management
# - DB_SYNC_ALTER=true to allow sequelize.sync({ alter: true }) (dev only)
# - RUN_MIGRATIONS=true to run migrations at startup
DB_SYNC_ALTER=false
RUN_MIGRATIONS=true

# Security
JWT_SECRET=your_jwt_secret
REFRESH_SECRET=your_refresh_token_secret
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d

# CORS (comma-separated origins; leave empty in dev to allow all)
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
OTP_EXPIRE_MINUTES=10

COMPANY_NAME=FurniSense
SUPPORT_EMAIL=support@example.com

# Optional seed-on-startup (dev only)
RUN_SEEDS_ON_START=false
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change_me
